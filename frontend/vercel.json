{
  "framework": "vite",
  "installCommand": "cd .. && npm ci --include=dev --workspace frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/admin(?:/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api(?:/|$)|assets(?:/|$)).*",
      "dest": "/index.html"
    }
  ]
}
